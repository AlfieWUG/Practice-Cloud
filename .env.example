# AWS Configuration
AWS_REGION=eu-central-1
AWS_ACCESS_KEY_ID=your_access_key_here
AWS_SECRET_ACCESS_KEY=your_secret_key_here
AWS_DEFAULT_REGION=eu-central-1

# AWS Bedrock
BEDROCK_MODEL_ID=anthropic.claude-3-sonnet-20240229-v1:0
BEDROCK_MAX_TOKENS=10000

# Application
APP_ENV=development
APP_DEBUG=true
LOG_LEVEL=INFO

# Database (DynamoDB)
DYNAMODB_TABLE_PREFIX=agentic-services
DYNAMODB_ENDPOINT=  # Leave empty for AWS, or set to http://localhost:8000 for local DynamoDB

# S3 Buckets
S3_DISCOVERY_BUCKET=nagarro-agentic-discovery-dev
S3_ARTIFACTS_BUCKET=nagarro-agentic-artifacts-dev
S3_LOGS_BUCKET=nagarro-agentic-logs-dev

# VPC Configuration
VPC_ID=vpc-xxxxxxxxx
PRIVATE_SUBNET_IDS=subnet-xxxxx,subnet-yyyyy
SECURITY_GROUP_ID=sg-xxxxxxxxx

# ECS Configuration
ECS_CLUSTER_NAME=agentic-services-cluster
ECS_TASK_EXECUTION_ROLE_ARN=arn:aws:iam::ACCOUNT_ID:role/ecsTaskExecutionRole

# EventBridge
EVENT_BUS_NAME=agentic-services-event-bus

# Secrets Manager
SECRETS_MANAGER_PREFIX=agentic-services/

# Cognito
COGNITO_USER_POOL_ID=eu-central-1_xxxxxxxxx
COGNITO_CLIENT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxx

# API Configuration
API_BASE_URL=https://api.nagarro-agentic.com/v1
API_TIMEOUT=30

# Redis/ElastiCache
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0

# Monitoring
CLOUDWATCH_LOG_GROUP=/aws/agentic-services
XRAY_ENABLED=true

# Demo Mode
DEMO_MODE=false
DEMO_DATA_PATH=demo/artifacts

# Dashboard Authentication
DASHBOARD_USERNAME=your_username_here
DASHBOARD_PASSWORD=your_secure_password_here
USE_AWS_SECRETS=false  # Set to true to use AWS Secrets Manager
DASHBOARD_SECRET_NAME=agentic-services/dashboard-credentials

# Streamlit
STREAMLIT_SERVER_PORT=8501
STREAMLIT_SERVER_ADDRESS=0.0.0.0
STREAMLIT_BROWSER_GATHER_USAGE_STATS=false
