# Application
APP_NAME="Nagarro Agentic Services Portal"
APP_ENV=development
DEBUG=true
LOG_LEVEL=INFO

# API Configuration
API_V1_PREFIX=/api/v1
CORS_ORIGINS=http://localhost:3000,http://localhost:8000

# Database
DATABASE_URL=postgresql://agentic:agentic123@localhost:5432/agentic_portal
# For SQLite (local dev): sqlite:///./agentic_portal.db

# Security
SECRET_KEY=your-secret-key-change-in-production-min-32-chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# AWS Configuration (for agent execution)
AWS_REGION=eu-central-1
AWS_ACCESS_KEY_ID=your-aws-access-key
AWS_SECRET_ACCESS_KEY=your-aws-secret-key

# AWS Resources (from main platform)
AGENTIC_SERVICES_API_ENDPOINT=https://your-api-gateway-url.execute-api.eu-central-1.amazonaws.com
S3_DISCOVERY_BUCKET=agentic-services-discovery
S3_ARTIFACTS_BUCKET=agentic-services-artifacts
DYNAMODB_TABLE_PREFIX=agentic-services

# Demo Mode (set to true for local testing without AWS)
DEMO_MODE=false

# Pagination
DEFAULT_PAGE_SIZE=20
MAX_PAGE_SIZE=100
